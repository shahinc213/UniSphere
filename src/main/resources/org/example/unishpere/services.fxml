        <Button layoutX="1069.0" layoutY="335.0" mnemonicParsing="false" onAction="#goToResourcesPage" prefHeight="145.0" prefWidth="142.0" style="-fx-background-color: 0; -fx-background-radius: 100;" />
        <Button fx:id="toLet" layoutX="1250.0" layoutY="569.0" mnemonicParsing="false" onAction="#goToToLetPage" prefHeight="145.0" prefWidth="142.0" style="-fx-background-color: 0; -fx-background-radius: 100;" />
