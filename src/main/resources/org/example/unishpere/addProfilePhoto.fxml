<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="profilePhotoPane" prefHeight="481.0" prefWidth="400.0" style="-fx-background-color: #f7f7f7;" stylesheets="@../../../../../css/styles.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="org.example.unishpere.profilePhotoController">

    <VBox fx:id="mainVBox" alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="50" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.topAnchor="50">

        <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #333;" text="Upload Your Profile Photo" />

        <ImageView fx:id="imagePreview" fitHeight="200" fitWidth="200" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 2, 2); -fx-background-color: #eaeaea; -fx-background-radius: 100;" />

        <Button fx:id="uploadButton" onAction="#chooseImage" styleClass="upload-button" stylesheets="@../../../../../css/styles.css" text="Choose Image" />

        <Button fx:id="saveButton" onAction="#saveProfilePhoto" styleClass="save-button" text="Save Profile Photo" />
    </VBox>
</AnchorPane>
