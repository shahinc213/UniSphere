<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="430.0" prefWidth="400.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 0);" styleClass="accepted-card" stylesheets="@../../../css/cards.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.unishpere.acceptedRequestCardonRequesterSideController">
   <children>
      <Circle fx:id="photo" fill="DODGERBLUE" layoutX="200.0" layoutY="80.0" radius="50.0" stroke="BLACK" strokeType="INSIDE" />
      <Label fx:id="name" alignment="CENTER" layoutX="50.0" layoutY="130.0" prefHeight="30.0" prefWidth="300.0" stylesheets="@../../../css/cards.css" text="Name" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label fx:id="course" alignment="CENTER" layoutX="50.0" layoutY="174.0" prefHeight="25.0" prefWidth="300.0" styleClass="course-label" stylesheets="@../../../css/cards.css" text="Course" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="topic" alignment="CENTER" layoutX="50.0" layoutY="203.0" prefHeight="25.0" prefWidth="300.0" styleClass="topic-label" stylesheets="@../../../css/cards.css" text="Topic" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="description" alignment="CENTER" layoutX="25.0" layoutY="234.0" prefHeight="90.0" prefWidth="350.0" styleClass="description-label" stylesheets="@../../../css/cards.css" text="Description" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label alignment="CENTER" layoutX="53.0" layoutY="324.0" prefHeight="30.0" prefWidth="144.0" style="-fx-text-fill: #3498db;" styleClass="accepted-message" stylesheets="@../../../css/cards.css" text="Accepted by:" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Label fx:id="accepterName" layoutX="143.0" layoutY="324.0" prefHeight="30.0" prefWidth="194.0" style="-fx-text-fill: #2980b9;" styleClass="accepted-message" stylesheets="@../../../css/cards.css" text="Accepter Name" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Button fx:id="messageButton" layoutX="125.0" layoutY="368.0" mnemonicParsing="false" onAction="#handleMessageButton" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #e67e22; -fx-background-radius: 20;" styleClass="message-button" stylesheets="@../../../css/cards.css" text="MESSAGE" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
